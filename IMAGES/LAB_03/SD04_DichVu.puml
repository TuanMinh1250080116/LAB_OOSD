@startuml
skinparam dpi 180
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam linetype ortho
actor "Nhân viên" as NV
boundary FrmDichVu as F
control DichVuService as S
database "SQL Server / Db" as DB
NV -> F : Nhập và yêu cầu xử lý
F -> S : GhiNhan(...)
S -> S : Phiếu đang ở; số lượng hợp lệ
alt Dữ liệu hợp lệ
 S -> DB : Tìm/tạo phiếu ngày và cộng dồn dòng dịch vụ
 DB --> S : Kết quả
 S --> F : Thành công / dữ liệu
else Không hợp lệ hoặc lỗi
 S --> F : Thông báo lỗi; không ghi dở dang
end
F --> NV : Hiển thị kết quả
@enduml
