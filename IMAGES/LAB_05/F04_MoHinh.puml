@startuml
skinparam defaultFontName Tahoma
skinparam defaultFontSize 12
skinparam dpi 140
skinparam shadowing true
skinparam BackgroundColor #FFFFFF
skinparam ArrowColor #8B0000
skinparam ActorBorderColor #8B0000
skinparam ActorBackgroundColor #FFFFCC
skinparam UsecaseBackgroundColor #FFFFCC
skinparam UsecaseBorderColor #8B0000
skinparam ClassBackgroundColor #FFFFCC
skinparam ClassBorderColor #8B0000
skinparam ClassHeaderBackgroundColor #FFF2A8
skinparam PackageBackgroundColor #FAFAF0
skinparam PackageBorderColor #8B0000
skinparam StateBackgroundColor #FFFFCC
skinparam StateBorderColor #8B0000
skinparam ActivityBackgroundColor #FFFFCC
skinparam ActivityBorderColor #8B0000
skinparam PartitionBorderColor #8B0000
skinparam ParticipantBackgroundColor #FFFFCC
skinparam ParticipantBorderColor #8B0000
skinparam SequenceLifeLineBorderColor #8B0000
skinparam NoteBackgroundColor #E8F4FF
skinparam RectangleBorderColor #8B0000
left to right direction
title Phân rã "Đăng ký theo đoàn"
actor "NV kinh doanh" as KD
actor "Cty bảo hiểm" as BH <<external>>
rectangle "Đăng ký theo đoàn" {
  usecase "Tìm khách đoàn" as A
  usecase "Thêm khách đoàn mới" as B
  usecase "Chọn tour, ngày đi" as C
  usecase "Tính kinh phí" as D
  usecase "Nhận cọc (≥ 30%)" as E
  usecase "Nhập người đi cùng" as F
  usecase "Lưu phiếu" as G
  usecase "Sửa danh sách\ntrước khởi hành" as H
}
KD --> A
KD --> C
KD --> G
KD --> H
B ..> A : <<extend>>\n[không tìm thấy]
C ..> D : <<include>>
G ..> E : <<include>>
F ..> G : <<extend>>\n[có bảo hiểm]
F --> BH
@enduml
