@startuml
skinparam defaultFontName Tahoma
skinparam defaultFontSize 12
skinparam dpi 140
skinparam shadowing true
skinparam BackgroundColor #FFFFFF
skinparam ArrowColor #8B0000
skinparam ActorBorderColor #8B0000
skinparam ActorBackgroundColor #FFFFCC
skinparam UsecaseBackgroundColor #FFFFCC
skinparam UsecaseBorderColor #8B0000
skinparam ClassBackgroundColor #FFFFCC
skinparam ClassBorderColor #8B0000
skinparam ClassHeaderBackgroundColor #FFF2A8
skinparam PackageBackgroundColor #FAFAF0
skinparam PackageBorderColor #8B0000
skinparam StateBackgroundColor #FFFFCC
skinparam StateBorderColor #8B0000
skinparam ActivityBackgroundColor #FFFFCC
skinparam ActivityBorderColor #8B0000
skinparam PartitionBorderColor #8B0000
skinparam ParticipantBackgroundColor #FFFFCC
skinparam ParticipantBorderColor #8B0000
skinparam SequenceLifeLineBorderColor #8B0000
skinparam NoteBackgroundColor #E8F4FF
skinparam RectangleBorderColor #8B0000
title Lớp chi tiết - mô-đun chuyến đi và bán vé
class FrmBanVe {
  - _sv : ChuyenVeService
  - _maKL : string
  - NapChuyen(chon : string)
  - btnTimKhach_Click()
  - btnBanVe_Click()
  - btnHuyVe_Click()
  - DoiTrangThai(moi : string)
}
class ChuyenVeService {
  + SoNguoiToiDaKhachLe : int = 12
  + LayChuyen() : DataTable
  + TimKhachLe(soGiayTo) : DataRow
  + ThemChuyen(maTour, ngayDi, soCho) : KetQua
  + BanVe(v : VeDto, k : KhachLeDto) : KetQua
  + HuyVe(soVe) : KetQua
  + ChuyenTrangThai(ma, moi) : KetQua
}
class VeDto {
  + MaChuyen : string
  + MaKL : string
  + MaDiemBan : string
  + MaDiemDon : string
  + SoNguoi : int
}
class KhachLeDto {
  + HoTen : string
  + SoGiayTo : string
  + DienThoai : string
  + DiaChi : string
}
class KetQua
class Db
FrmBanVe --> ChuyenVeService
ChuyenVeService ..> VeDto
ChuyenVeService ..> KhachLeDto
ChuyenVeService ..> KetQua
ChuyenVeService ..> Db
@enduml
